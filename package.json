  "version": "0.1.0",
  "type": "module",
  "description": "MY STREAM HUB — Professional Native Live Streaming Studio (Phase 1: Core Backend & Media Runtime)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
