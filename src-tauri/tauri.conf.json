{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MY STREAM HUB",
  "version": "0.1.0",
  "identifier": "com.mystreamhub.studio",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MY STREAM HUB",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "darkMode": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Video",
    "windows": {
      "certification": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
